@using GoodManager.Application.Tools
@using GoodManager.Domain.DTOs.ViewModels.Accounting.Transactions
@using GoodManager.Domain.Enums.Accounting

@model UpdateAccountingTransactionViewModel

<form id="editForm" isSwal="true" editForm method="post"
    asp-action="Update" 
    asp-controller="Transaction">
    <div class="card w-full">
        <div class="space-y-4">
            <div class="grid grid-cols-12 gap-4">
                <label class="block col-span-12 lg:col-span-4">
                    <label asp-for="TransactionType"></label>
                    <select asp-for="TransactionType" class="form-select mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 hover:border-slate-400 focus:border-primary dark:border-navy-450 dark:bg-navy-700 dark:hover:border-navy-400 dark:focus:border-accent">

                        @foreach (var item in Enum.GetValues(typeof(AccountingTransactionType)).Cast<AccountingTransactionType>())
                        {
                            if (Model.TransactionType == item)
                            {
                                <option value="@item" selected="">@item.GetEnumName()</option>
                            }
                            else
                            {
                                <option value="@item">@item.GetEnumName()</option>
                            }
                        }
                    </select>
                </label>
                <label class="block col-span-12 lg:col-span-4">
                    <label asp-for="TransactionCause"></label>
                    <select asp-for="TransactionCause" class="form-select mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 hover:border-slate-400 focus:border-primary dark:border-navy-450 dark:bg-navy-700 dark:hover:border-navy-400 dark:focus:border-accent">

                        @foreach (var item in Enum.GetValues(typeof(AccountingTransactionCause)).Cast<AccountingTransactionCause>())
                        {
                            if (Model.TransactionCause == item)
                            {
                                <option value="@item" selected="">@item.GetEnumName()</option>
                            }
                            else
                            {
                                <option value="@item">@item.GetEnumName()</option>
                            }
                        }
                    </select>
                </label>
                <label class="block col-span-12 lg:col-span-4">
                    <label asp-for="TransactionWay"></label>
                    <select asp-for="TransactionWay" class="form-select mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 hover:border-slate-400 focus:border-primary dark:border-navy-450 dark:bg-navy-700 dark:hover:border-navy-400 dark:focus:border-accent">

                        @foreach (var item in Enum.GetValues(typeof(AccountingTransactionWay)).Cast<AccountingTransactionWay>())
                        {
                            if (Model.TransactionWay == item)
                            {
                                <option value="@item" selected="">@item.GetEnumName()</option>
                            }
                            else
                            {
                                <option value="@item">@item.GetEnumName()</option>
                            }
                        }
                    </select>
                </label>
            </div>
            <div class="flex justify-center pt-4">
                <button type="button" onclick="swal.close()" class="btn ml-3 min-w-[7rem] border border-slate-300 font-medium text-slate-800 hover:bg-slate-150 focus:bg-slate-150 active:bg-slate-150/80 dark:border-navy-450 dark:text-navy-50 dark:hover:bg-navy-500 dark:focus:bg-navy-500 dark:active:bg-navy-500/90">
                    بستن
                </button>
                <button class="btn min-w-[7rem] bg-primary font-medium text-white hover:bg-primary-focus focus:bg-primary-focus active:bg-primary-focus/90 dark:bg-accent dark:hover:bg-accent-focus dark:focus:bg-accent-focus dark:active:bg-accent/90">
                    ثبت
                </button>
            </div>
        </div>
    </div>
</form>