@using GoodManager.Domain.DTOs.ViewModels.Accounting.Transactions.Report
@model AccountingCostsAndIncomeReportViewModel

<div class="card card px-4 pb-5 sm:px-5">
    <div class="my-3 flex items-center justify-between">
        <h2 class="font-medium tracking-wide text-slate-700 dark:text-navy-100">
            خلاصـه سال گذشته
        </h2>
        <div x-data="usePopper({placement:'bottom-start',offset:4})" @@click.outside ="if(isShowPopper) isShowPopper = false" class="inline-flex">
            <button x-ref="popperRef" @@click ="isShowPopper = !isShowPopper" class="btn -mr-1.5 size-8 rounded-full p-0 hover:bg-slate-300/20 focus:bg-slate-300/20 active:bg-slate-300/25 dark:hover:bg-navy-300/20 dark:focus:bg-navy-300/20 dark:active:bg-navy-300/25">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h.01M12 12h.01M19 12h.01M6 12a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0z"></path>
                </svg>
            </button>

            <div x-ref="popperRoot" class="popper-root" :class="isShowPopper &amp;&amp; 'show'" style="position: fixed; inset: 0px auto auto 0px; margin: 0px; transform: translate3d(40px, 25px, 0px);" data-popper-placement="bottom-start">
                <div class="popper-box rounded-md border border-slate-150 bg-white py-1.5 font-inter dark:border-navy-500 dark:bg-navy-700">
                    <ul>
                        <li>
                            <a href="#" class="flex h-8 items-center px-3 pl-8 font-medium tracking-wide outline-hidden transition-all hover:bg-slate-100 hover:text-slate-800 focus:bg-slate-100 focus:text-slate-800 dark:hover:bg-navy-600 dark:hover:text-navy-100 dark:focus:bg-navy-600 dark:focus:text-navy-100">Action</a>
                        </li>
                        <li>
                            <a href="#" class="flex h-8 items-center px-3 pl-8 font-medium tracking-wide outline-hidden transition-all hover:bg-slate-100 hover:text-slate-800 focus:bg-slate-100 focus:text-slate-800 dark:hover:bg-navy-600 dark:hover:text-navy-100 dark:focus:bg-navy-600 dark:focus:text-navy-100">Another Action</a>
                        </li>
                        <li>
                            <a href="#" class="flex h-8 items-center px-3 pl-8 font-medium tracking-wide outline-hidden transition-all hover:bg-slate-100 hover:text-slate-800 focus:bg-slate-100 focus:text-slate-800 dark:hover:bg-navy-600 dark:hover:text-navy-100 dark:focus:bg-navy-600 dark:focus:text-navy-100">Something else</a>
                        </li>
                    </ul>
                    <div class="my-1 h-px bg-slate-150 dark:bg-navy-500"></div>
                    <ul>
                        <li>
                            <a href="#" class="flex h-8 items-center px-3 pl-8 font-medium tracking-wide outline-hidden transition-all hover:bg-slate-100 hover:text-slate-800 focus:bg-slate-100 focus:text-slate-800 dark:hover:bg-navy-600 dark:hover:text-navy-100 dark:focus:bg-navy-600 dark:focus:text-navy-100">Separated Link</a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
    <div class="grid grid-cols-2 gap-3 px-4">
        <div class="rounded-lg bg-slate-100 p-3 dark:bg-navy-600">
            <div class="flex justify-between space-x-1">
                <p priceTomanFormat class="text-xl font-semibold text-slate-700 dark:text-navy-100">
                    @Model.CostsSum
                </p>
                <i class="fas fa-dollar text-base"></i>
            </div>
            <p class="mt-1 text-xs-plus">مجموع هزینه ها</p>
        </div>
        <div class="rounded-lg bg-slate-100 p-3 dark:bg-navy-600">
            <div class="flex justify-between">
                <p priceTomanFormat class="text-xl font-semibold text-slate-700 dark:text-navy-100">
                    @Model.IncomeSum
                </p>
                <i class="fas fa-dollar text-base"></i>
            </div>
            <p class="mt-1 text-xs-plus">مجموع درآمد</p>
        </div>
    </div>
    <div class="mt- px-3">
        <div id="lastYearCostsAndIncomeChart"
             data-costs="@Json.Serialize(Model.Costs)"
             data-income="@Json.Serialize(Model.Income)"
             style="min-height: 249px;"
             class="apexcharts-tooltip-active">
        </div>
    </div>
</div>