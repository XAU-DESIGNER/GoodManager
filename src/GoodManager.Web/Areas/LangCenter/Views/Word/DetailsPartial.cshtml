@using GoodManager.Application.Tools
@using GoodManager.Domain.DTOs.ViewModels.LangCenter.Words
@using GoodManager.Domain.Enums.LangCenter
@model WordDetailsViewModel

<div class="card w-full">
    <div class="space-y-4">
        <div class="grid grid-cols-3 gap-4">
            <label class="block">
                <label asp-for="Title"></label>
                <input readonly disabled asp-for="Title" placeholder-for="Title" class="form-input mt-1.5 w-full rounded-lg bg-slate-150 px-3 py-2 ring-primary/50 placeholder:text-slate-400 hover:bg-slate-200 focus:ring-3 dark:bg-navy-900/90 dark:ring-accent/50 dark:placeholder:text-navy-300 dark:hover:bg-navy-900 dark:focus:bg-navy-900" type="text">
            </label>
            <label class="block">
                <label asp-for="Meaning"></label>
                <input readonly disabled asp-for="Meaning" placeholder-for="Meaning" class="form-input mt-1.5 w-full rounded-lg bg-slate-150 px-3 py-2 ring-primary/50 placeholder:text-slate-400 hover:bg-slate-200 focus:ring-3 dark:bg-navy-900/90 dark:ring-accent/50 dark:placeholder:text-navy-300 dark:hover:bg-navy-900 dark:focus:bg-navy-900">
            </label>
            <label class="block">
                <label asp-for="WordType"></label>
                @* <select readonly disabled asp-for="WordType" class="form-select mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 hover:border-slate-400 focus:border-primary dark:border-navy-450 dark:bg-navy-700 dark:hover:border-navy-400 dark:focus:border-accent">

                    @foreach (var item in Enum.GetValues(typeof(WordType)).Cast<WordType>())
                    {
                        if (Model.WordType == item)
                        {
                            <option value="@item" selected="">@item.GetEnumName()</option>
                        }
                        else
                        {
                            <option value="@item">@item.GetEnumName()</option>
                        }
                    }
                </select> *@
                <input readonly disabled value="@Model.WordType.GetEnumName()" placeholder-for="WordType" class="form-input mt-1.5 w-full rounded-lg bg-slate-150 px-3 py-2 ring-primary/50 placeholder:text-slate-400 hover:bg-slate-200 focus:ring-3 dark:bg-navy-900/90 dark:ring-accent/50 dark:placeholder:text-navy-300 dark:hover:bg-navy-900 dark:focus:bg-navy-900"/>
            </label>
        </div>
        <div class="flex justify-center pt-4">
            <button type="button" onclick="swal.close()" class="btn min-w-[7rem] border border-slate-300 font-medium text-slate-800 hover:bg-slate-150 focus:bg-slate-150 active:bg-slate-150/80 dark:border-navy-450 dark:text-navy-50 dark:hover:bg-navy-500 dark:focus:bg-navy-500 dark:active:bg-navy-500/90">
                بستن
            </button>
        </div>
    </div>
</div>